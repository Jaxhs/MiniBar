<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MiniBar</AssemblyName>
    <RootNamespace>MiniBar.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 低内存取向：单线程服务器 GC 关闭、并发 GC 关闭、不做 ReadyToRun 之外的裁剪 -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickStartupJit>true</TieredCompilationQuickStartupJit>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiniBar.Sdk\MiniBar.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**" />
  </ItemGroup>

</Project>
