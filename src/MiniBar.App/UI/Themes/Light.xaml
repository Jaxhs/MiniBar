<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题。ThemeService 会把本字典插入 Application.Resources.MergedDictionaries[0]，
         所有界面用 DynamicResource 引用，因此切换主题时立即生效。 -->

    <SolidColorBrush x:Key="BarBackgroundBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="BarBorderBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#14000000" />
    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#22000000" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#FF6B6B75" />
    <SolidColorBrush x:Key="BorderBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#17000000" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="ActiveBrush" Color="#2A000000" />
    <SolidColorBrush x:Key="BadgeBrush" Color="#FFE9E9EF" />
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FBFFFFFF" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#33000000" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFD93025" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33000000" />

</ResourceDictionary>
