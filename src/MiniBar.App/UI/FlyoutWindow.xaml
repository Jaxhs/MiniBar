<Window x:Class="MiniBar.App.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniBar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="380"
        Height="320"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border x:Name="RootBorder"
            Margin="10"
            CornerRadius="12"
            AllowDrop="True"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.28" Color="#FF000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="12,7,7,3">
                <TextBlock x:Name="TitleText"
                           Text="插件"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedForegroundBrush}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PinButton"
                            Style="{StaticResource IconButtonStyle}"
                            Width="26"
                            Height="26"
                            Click="OnPinClick"
                            ToolTip="钉住：失去焦点时不自动关闭">
                        <TextBlock x:Name="PinGlyph"
                                   Text="&#xE718;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource IconButtonStyle}"
                            Width="26"
                            Height="26"
                            Margin="2,0,0,0"
                            Click="OnCloseClick"
                            ToolTip="关闭">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <ContentPresenter x:Name="ContentHost"
                              Grid.Row="1"
                              Margin="12,0,12,12" />
        </Grid>
    </Border>
</Window>
