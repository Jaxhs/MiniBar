<Window x:Class="MiniBar.App.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniBar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="380"
        SizeToContent="Height"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border x:Name="RootBorder"
            Margin="10"
            CornerRadius="12"
            AllowDrop="True"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.28" Color="#FF000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="12,7,7,3">
                <TextBlock x:Name="TitleText"
                           Text="插件"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedForegroundBrush}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PinButton"
                            Style="{StaticResource IconButtonStyle}"
                            Width="26"
                            Height="26"
                            Click="OnPinClick"
                            ToolTip="钉住：失去焦点时不自动关闭">
                        <TextBlock x:Name="PinGlyph"
                                   Text="&#xE718;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource IconButtonStyle}"
                            Width="26"
                            Height="26"
                            Margin="2,0,0,0"
                            Click="OnCloseClick"
                            ToolTip="关闭">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 内容区包一层 ScrollViewer：
                 窗体高度是 SizeToContent="Height"（内容有多少就多高），
                 上限由代码按屏幕可用空间设置 MaxHeight，
                 所以内容再多也只会**纵向**滚动，不会被切掉。

                 注意这里必须是 HorizontalScrollBarVisibility="Disabled"：
                 一旦开横向滚动，内容会以"无限宽"去测量，TextWrapping 就永远不换行，
                 长文字反而会被挤成一条横向滚动条 —— 正确做法是让文字换行，
                 实在换不了行的（路径、文件名）由控件自己用省略号 + 悬停提示兜住。 -->
            <ScrollViewer x:Name="ContentScroller"
                          Grid.Row="1"
                          Margin="12,0,12,12"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ContentPresenter x:Name="ContentHost" />
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
