<UserControl x:Class="MiniBar.App.UI.PluginManagerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hosting="clr-namespace:MiniBar.App.Hosting"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        插件管理界面（原来是一个独立窗口 PluginManagerWindow，现在改成用户控件，
        直接嵌进设置窗口的"插件管理"页 —— 于是"看插件 / 管插件 / 改插件设置"在同一个窗口里完成）。

        它同时是**拖放区**：把插件 DLL 拖到这块区域上就会热加载。
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具条 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="AutoLoadCheck"
                      Content="拖入 DLL 即自动加载"
                      VerticalAlignment="Center"
                      Checked="OnAutoLoadChanged"
                      Unchecked="OnAutoLoadChanged" />
            <Border Width="1" Margin="10,2" Background="{DynamicResource SeparatorBrush}" />
            <Button Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" Click="OnReloadAllClick" Content="全部重新加载" />
            <Button Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" Click="OnDisableAllClick" Content="全部卸载" />
            <Button Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" Click="OnLoadFromFileClick" Content="从文件加载…" />
            <Button Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" Click="OnRefreshClick" Content="重新扫描目录" />
            <Button Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" Click="OnOpenFolderClick" Content="打开插件目录" />
        </StackPanel>

        <!-- 插件列表（同时也是拖放区） -->
        <Border x:Name="DropZone"
                Grid.Row="1"
                Margin="0,0,0,8"
                Padding="6"
                CornerRadius="10"
                AllowDrop="True"
                Background="{DynamicResource BarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource MiniBarScrollViewerStyle}">
                    <ItemsControl x:Name="PluginList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type hosting:PluginDescriptor}">
                                <Border Margin="2,2,2,6"
                                        Padding="10"
                                        CornerRadius="9"
                                        Background="{DynamicResource BarBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ContentControl Grid.Column="0"
                                                        Content="{Binding Icon}"
                                                        ContentTemplate="{StaticResource PluginIconTemplate}"
                                                        Width="26"
                                                        Height="26"
                                                        VerticalAlignment="Top"
                                                        Margin="2,2,0,0" />

                                        <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                            <!-- 名字行用 Grid 而不是横向 StackPanel：
                                                 横向 StackPanel 会给子元素无限宽度，TextTrimming 永远不会生效，
                                                 插件名一长就直接被裁掉（"内容显示不全"）。
                                                 Grid 的 * 列有确定宽度，省略号和悬停提示才能正常工作。 -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DisplayName}" />
                                                    <TextBlock Text="{Binding Version}"
                                                               Margin="7,0,0,0"
                                                               FontSize="11.5"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                                </StackPanel>

                                                <Border Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        Padding="6,1"
                                                        CornerRadius="6"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource SurfaceStrongBrush}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" />
                                                </Border>
                                                <Border Grid.Column="2"
                                                        Margin="5,0,0,0"
                                                        Padding="6,1"
                                                        CornerRadius="6"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentBrush}"
                                                        Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="已固定"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource AccentForegroundBrush}" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding Id}"
                                                       FontSize="11"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Id}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" />

                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11.5"
                                                       Margin="0,3,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       Visibility="{Binding Description, Converter={StaticResource NotEmptyToVisibility}}" />

                                            <TextBlock Text="{Binding CapabilityText}"
                                                       FontSize="11"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" />

                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="10.5"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FilePath}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" />

                                            <TextBlock Text="{Binding Error}"
                                                       FontSize="11.5"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    Width="28" Height="28"
                                                    Tag="{Binding}"
                                                    Click="OnOpenPanelClick"
                                                    IsEnabled="{Binding CanOpen}"
                                                    ToolTip="打开界面">
                                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    Width="28" Height="28"
                                                    Tag="{Binding}"
                                                    Click="OnTogglePinClick"
                                                    ToolTip="固定 / 取消固定">
                                                <TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    Width="28" Height="28"
                                                    Tag="{Binding}"
                                                    Click="OnToggleEnabledClick"
                                                    ToolTip="启用 / 禁用（禁用后不占内存）">
                                                <TextBlock Text="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    Width="28" Height="28"
                                                    Tag="{Binding}"
                                                    Click="OnReloadClick"
                                                    ToolTip="重新加载">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    Width="28" Height="28"
                                                    Tag="{Binding}"
                                                    Click="OnSettingsClick"
                                                    ToolTip="打开设置（宿主设置 + 插件自己的设置项）">
                                                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    Width="28" Height="28"
                                                    Tag="{Binding}"
                                                    Click="OnDeleteClick"
                                                    IsEnabled="{Binding CanDelete}"
                                                    ToolTip="卸载并删除插件文件">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint"
                           Text="还没有发现插件。把插件 DLL 拖到这里（或任务栏上），或复制到「用户插件目录」后点“重新扫描目录”。"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           MaxWidth="420"
                           TextAlignment="Center"
                           Foreground="{DynamicResource MutedForegroundBrush}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
            <TextBlock x:Name="UserDirText"
                       FontSize="11.5"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
