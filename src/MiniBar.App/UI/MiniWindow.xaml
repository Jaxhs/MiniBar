<Window x:Class="MiniBar.App.UI.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniBar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        AllowDrop="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border x:Name="MiniBorder"
            Margin="8"
            CornerRadius="12"
            Padding="12,8"
            AllowDrop="True"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.30" Color="#FF000000" />
        </Border.Effect>

        <ContentPresenter x:Name="MiniContent"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          AllowDrop="True" />
    </Border>
</Window>
