<Window x:Class="MiniBar.App.UI.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniBar"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="420"
        Height="320"
        MinWidth="200"
        MinHeight="120"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Background="{DynamicResource PanelBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Height="34">
            <TextBlock x:Name="TitleText"
                       Margin="12,0,0,0"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,5,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="PinButton"
                        Style="{StaticResource IconButtonStyle}"
                        Width="26"
                        Height="26"
                        Click="OnPinClick"
                        ToolTip="置顶开关">
                    <TextBlock x:Name="PinGlyph"
                               Text="&#xE77A;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12" />
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource IconButtonStyle}"
                        Width="26"
                        Height="26"
                        Margin="2,0,0,0"
                        Click="OnCloseClick"
                        ToolTip="关闭">
                    <TextBlock Text="&#xE711;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource SeparatorBrush}" />

        <ContentPresenter x:Name="BodyHost" Grid.Row="1" Margin="0" />
    </Grid>
</Window>
