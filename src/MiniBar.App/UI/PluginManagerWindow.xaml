<Window x:Class="MiniBar.App.UI.PluginManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hosting="clr-namespace:MiniBar.App.Hosting"
        Title="插件管理 - MiniBar"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Width="820"
        Height="560"
        MinWidth="560"
        MinHeight="320"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Background="{DynamicResource BarBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Height="38">
            <TextBlock Text="插件管理"
                       Margin="14,0,0,0"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,5,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource IconButtonStyle}" Click="OnRefreshClick" ToolTip="重新扫描插件目录">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="OnOpenFolderClick" ToolTip="打开用户插件目录">
                    <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="OnCloseClick" ToolTip="关闭">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource SeparatorBrush}" />

        <!-- 工具条 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,10,14,6">
            <CheckBox x:Name="AutoLoadCheck"
                      Content="拖入 DLL 即自动加载"
                      VerticalAlignment="Center"
                      Checked="OnAutoLoadChanged"
                      Unchecked="OnAutoLoadChanged" />
            <Border Width="1" Margin="10,2" Background="{DynamicResource SeparatorBrush}" />
            <Button Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" Click="OnReloadAllClick" Content="全部重新加载" />
            <Button Style="{StaticResource PanelButtonStyle}" Margin="0,0,6,0" Click="OnDisableAllClick" Content="全部卸载" />
            <TextBlock x:Name="PathHint"
                       VerticalAlignment="Center"
                       Margin="4,0,0,0"
                       FontSize="11.5"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="330"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
        </StackPanel>

        <!-- 插件列表（同时也是拖放区） -->
        <Border x:Name="DropZone"
                Grid.Row="2"
                Margin="14,4,14,8"
                Padding="6"
                CornerRadius="10"
                AllowDrop="True"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource MiniBarScrollViewerStyle}">
                    <ItemsControl x:Name="PluginList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type hosting:PluginDescriptor}">
                                <Border Margin="2,2,2,6"
                                        Padding="10"
                                        CornerRadius="9"
                                        Background="{DynamicResource BarBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ContentControl Grid.Column="0"
                                                        Content="{Binding Icon}"
                                                        ContentTemplate="{StaticResource PluginIconTemplate}"
                                                        Width="26"
                                                        Height="26"
                                                        VerticalAlignment="Top"
                                                        Margin="2,2,0,0" />

                                        <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Version}"
                                                           Margin="7,0,0,0"
                                                           FontSize="11.5"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MutedForegroundBrush}" />
                                                <Border Margin="8,0,0,0"
                                                        Padding="6,1"
                                                        CornerRadius="6"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource SurfaceStrongBrush}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" />
                                                </Border>
                                                <Border Margin="5,0,0,0"
                                                        Padding="6,1"
                                                        CornerRadius="6"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentBrush}"
                                                        Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="已固定"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource AccentForegroundBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Id}"
                                                       FontSize="11"
                                                       Margin="0,3,0,0"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" />

                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11.5"
                                                       Margin="0,3,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       Visibility="{Binding Description, Converter={StaticResource NotEmptyToVisibility}}" />

                                            <TextBlock Text="{Binding CapabilityText}"
                                                       FontSize="11"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" />

                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="10.5"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FilePath}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" />

                                            <TextBlock Text="{Binding Error}"
                                                       FontSize="11.5"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    Width="28" Height="28"
                                                    Tag="{Binding}"
                                                    Click="OnOpenPanelClick"
                                                    IsEnabled="{Binding CanOpen}"
                                                    ToolTip="打开界面">
                                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    Width="28" Height="28"
                                                    Tag="{Binding}"
                                                    Click="OnTogglePinClick"
                                                    ToolTip="固定 / 取消固定">
                                                <TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    Width="28" Height="28"
                                                    Tag="{Binding}"
                                                    Click="OnToggleEnabledClick"
                                                    ToolTip="启用 / 禁用（禁用后不占内存）">
                                                <TextBlock Text="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    Width="28" Height="28"
                                                    Tag="{Binding}"
                                                    Click="OnReloadClick"
                                                    ToolTip="重新加载">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    Width="28" Height="28"
                                                    Tag="{Binding}"
                                                    Click="OnSettingsClick"
                                                    ToolTip="打开设置（宿主设置 + 插件自己的设置项）">
                                                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    Width="28" Height="28"
                                                    Tag="{Binding}"
                                                    Click="OnDeleteClick"
                                                    IsEnabled="{Binding CanDelete}"
                                                    ToolTip="卸载并删除插件文件">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint"
                           Text="还没有发现插件。把插件 DLL 拖到这个窗口（或任务栏上），或复制到下面的目录后点“重新扫描”。"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           MaxWidth="420"
                           TextAlignment="Center"
                           Foreground="{DynamicResource MutedForegroundBrush}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="16,0,16,12">
            <TextBlock x:Name="UserDirText"
                       FontSize="11.5"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
        </StackPanel>
    </Grid>
</Window>
